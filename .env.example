# ====================================================================
# TKJ Service Center - Environment Variables Template
# Copy this file to your local server environment or include in Apache/PHP-FPM
# DO NOT commit real API secrets/tokens to git!
# ====================================================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=db_tkj_service
DB_PORT=3306

# OTP & Gateway Settings
# Provider options: fonnte | wablas | twilio | generic | mock
OTP_PROVIDER=fonnte
OTP_API_TOKEN=your_api_token_here
OTP_API_ENDPOINT=https://api.fonnte.com/send
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60
OTP_RATE_LIMIT_PER_HOUR=5
